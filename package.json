{
  "name": "wetmytt",
  "productName": "Welcome to My TED Talk",
  "version": "0.2.0",
  "private": true,
  "description": "A local desktop app for HTML slide decks.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:web": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64 --x64 --publish never",
    "dist:mac:arm64": "npm run build && electron-builder --mac dmg --arm64 --publish never",
    "dist:mac:x64": "npm run build && electron-builder --mac dmg --x64 --publish never",
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:screenshot": "node --test tests/screenshot.integration.js",
    "test:edit": "node --test tests/content.integration.js",
    "typecheck": "tsc --noEmit",
    "test:pdf": "node --test tests/pdf.integration.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "chokidar": "^4.0.3",
    "fflate": "^0.8.3",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.16.1",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "electron@45.0.0": true
  }
}
