{
  "name": "wetmytt",
  "productName": "Welcome to My TED Talk",
  "version": "0.3.1",
  "private": true,
  "license": "MIT",
  "description": "A local desktop app for HTML slide decks.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:web": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "dist:mac:arm64": "npm run build && electron-builder --mac dmg zip --arm64 --publish never",
    "dist:mac:x64": "npm run build && electron-builder --mac dmg zip --x64 --publish never",
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:screenshot": "node --test tests/screenshot.integration.js",
    "test:thumbnails": "node --test tests/thumbnails.integration.js",
    "test:recent": "node --test tests/recent.integration.js",
    "test:quit": "node --test tests/quit.integration.js",
    "test:settings": "node --test tests/settings.integration.js",
    "test:chat": "node --test tests/chat.integration.js",
    "test:edit": "node --test tests/content.integration.js",
    "typecheck": "tsc --noEmit",
    "test:pdf": "node --test tests/pdf.integration.js",
    "test:package": "node --test tests/packaged-tools.integration.js"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.31",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "cheerio": "^1.2.0",
    "chokidar": "^4.0.3",
    "diff": "^9.0.0",
    "dugite": "^3.3.1",
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "undici": "^7.30.1",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.16.1",
    "js-yaml": "^4.3.2",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "electron@45.0.0": true,
    "dugite@3.3.1": true
  }
}
